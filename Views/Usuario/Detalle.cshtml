@model ProyectoFinalMVC.Models.Usuario
@{
    ViewData["Title"] = "Detalle de usuario";
}

<h1>Detalle de usuario</h1>
<hr />

<div class="card" style="max-width: 600px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Id</dt>
            <dd class="col-sm-8">@Model.Id_usuario</dd>

            <dt class="col-sm-4">Nombre de usuario</dt>
            <dd class="col-sm-8">@Model.NombreUsuario</dd>

            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Rol</dt>
            <dd class="col-sm-8">@Model.Rol</dd>

            <dt class="col-sm-4">Fecha de registro</dt>
            <dd class="col-sm-8">@Model.FechaCreacion.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Foto de perfil</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.RutaFoto))
                {
                    <img src="@Model.RutaFoto" alt="Foto de @Model.NombreUsuario" class="rounded-circle" style="width: 64px; height: 64px; object-fit: cover;" />
                }
                else
                {
                    <span class="text-muted">Sin foto</span>
                }
            </dd>
        </dl>
    </div>
</div>

<a asp-controller="Usuario" asp-action="Index" class="btn btn-outline-secondary mt-3">Volver</a>