@model ProyectoFinalMVC.Models.Tutorial
@{
    ViewData["Title"] = "Publicar tutorial";
}

<h1>Publicar tutorial</h1>
<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-controller="Tutorial" asp-action="Crear" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Titulo" class="form-label">Título</label>
                <input asp-for="Titulo" class="form-control" maxlength="200" required />
                <span asp-validation-for="Titulo" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label">Descripción</label>
                <textarea asp-for="Descripcion" class="form-control" rows="4" maxlength="1000" required></textarea>
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Url" class="form-label">URL del video de YouTube</label>
                <input asp-for="Url" class="form-control" maxlength="200" required />
                <span asp-validation-for="Url" class="text-danger"></span>
                <small class="text-muted">La miniatura se tomará automáticamente del video.</small>
            </div>

            <div class="mb-3">
                <label asp-for="TecnologiaId" class="form-label">Tecnología</label>
                <div class="input-group" style="position: relative;">
                    <input type="text" id="tecnologiaBusqueda" class="form-control" autocomplete="off"
                           placeholder="Selecciona de la lista o escribe para filtrar..." />
                    <input type="hidden" id="tecnologiaIdSeleccionada" name="TecnologiaId" required />
                </div>
                <span asp-validation-for="TecnologiaId" class="text-danger"></span>
                <small class="text-muted">Al enfocar el campo se muestra la lista completa; escribe para filtrar.</small>
            </div>

            <style>
    .search-results {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        margin-top: 2px;
        background: #ffffff;
        border: 1px solid #ced4da;
        border-radius: .25rem;
        box-shadow: 0 .5rem 1rem rgba(0, 0, 0, .075);
        max-height: 220px;
        overflow-y: auto;
        z-index: 1050;
    }

    .search-results.menu-con-error {
        border-color: #dc3545;
    }

    .search-results .opcion-tecnologia {
        background: #ffffff;
        padding: .45rem .75rem;
        cursor: pointer;
    }

    .search-results .opcion-tecnologia:hover {
        background: #f1f3f5;
    }

    .search-results .mensaje-vacio {
        padding: .45rem .75rem;
        color: #6c757d;
    }

    .search-results .mensaje-error {
        padding: .45rem .75rem;
        color: #dc3545;
    }
</style>

<script>
                const inputBusqueda = document.getElementById('tecnologiaBusqueda');
                const inputOculto = document.getElementById('tecnologiaIdSeleccionada');
                const RETRASO_MS = 250;

                let temporizadorBusqueda = null;
                let peticionActual = null;

                function seleccionarTecnologia(opcion) {
                    inputOculto.value = opcion.dataset.id;
                    inputBusqueda.value = opcion.textContent;
                    cerrarMenu();
                }

                function cerrarMenu() {
                    inputBusqueda.parentElement.querySelectorAll('.search-results').forEach(el => el.remove());
                }

                function pintarMenu(datos) {
                    const contenedor = document.createElement('div');
                    contenedor.className = 'search-results';

                    if (!datos || datos.length === 0) {
                        const vacio = document.createElement('div');
                        vacio.className = 'mensaje-vacio';
                        vacio.textContent = 'No hay tecnologías que coincidan con la búsqueda.';
                        contenedor.appendChild(vacio);
                    } else {
                        datos.forEach(t => {
                            const opcion = document.createElement('div');
                            opcion.className = 'opcion-tecnologia';
                            opcion.textContent = t.nombre;
                            opcion.dataset.id = t.idTecnologia;
                            contenedor.appendChild(opcion);
                        });
                    }

                    cerrarMenu();
                    inputBusqueda.parentElement.appendChild(contenedor);
                }

                function pintarError(texto) {
                    const contenedor = document.createElement('div');
                    contenedor.className = 'search-results menu-con-error';
                    const fallo = document.createElement('div');
                    fallo.className = 'mensaje-error';
                    fallo.textContent = texto;
                    contenedor.appendChild(fallo);
                    cerrarMenu();
                    inputBusqueda.parentElement.appendChild(contenedor);
                }

                function cancelarPeticion() {
                    if (peticionActual) {
                        peticionActual.abort();
                        peticionActual = null;
                    }
                    if (temporizadorBusqueda) {
                        clearTimeout(temporizadorBusqueda);
                        temporizadorBusqueda = null;
                    }
                }

                async function pedirAlServidor(url) {
                    cancelarPeticion();
                    peticionActual = new AbortController();

                    try {
                        const respuesta = await fetch(url, { signal: peticionActual.signal });
                        const datos = await respuesta.json();

                        if (!respuesta.ok) {
                            pintarError('No se pudieron cargar las tecnologías. Intenta de nuevo.');
                            return;
                        }

                        pintarMenu(datos);
                    } catch (error) {
                        if (error.name === 'AbortError') return;
                        pintarError('No se pudo conectar con el servidor. Revisa tu conexión e intenta de nuevo.');
                        console.error('Error de comunicación con el servidor:', error);
                    } finally {
                        if (peticionActual && peticionActual.signal.aborted === false) peticionActual = null;
                    }
                }

                function mostrarListaCompleta() {
                    pedirAlServidor('/api/tecnologias');
                }

                function abrirMenu() {
                    if (!inputBusqueda.parentElement.querySelector('.search-results')) {
                        mostrarListaCompleta();
                    }
                }

                inputBusqueda.addEventListener('focus', function () {
                    if (inputBusqueda.value.trim().length < 1) mostrarListaCompleta();
                });

                inputBusqueda.addEventListener('click', abrirMenu);

                inputBusqueda.addEventListener('input', function () {
                    inputOculto.value = '';
                    cancelarPeticion();
                    const termino = this.value.trim();

                    temporizadorBusqueda = setTimeout(function () {
                        if (termino.length < 1) {
                            mostrarListaCompleta();
                            return;
                        }
                        pedirAlServidor(`/api/tecnologias/buscar?termino=${encodeURIComponent(termino)}`);
                    }, RETRASO_MS);
                });

                document.addEventListener('click', function (e) {
                    if (e.target.dataset && e.target.dataset.id && e.target.closest('.search-results')) {
                        seleccionarTecnologia(e.target);
                        return;
                    }
                    if (!e.target.closest('.input-group')) {
                        cerrarMenu();
                    }
                });

                document.getElementById('tecnologiaIdSeleccionada').closest('form').addEventListener('submit', function (e) {
                    if (inputOculto.value === '') {
                        e.preventDefault();
                        inputBusqueda.style.borderColor = '#dc3545';
                        inputBusqueda.focus();
                    }
                });
            </script>

            <button type="submit" class="btn btn-primary">Publicar</button>
            <a asp-controller="Tutorial" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
