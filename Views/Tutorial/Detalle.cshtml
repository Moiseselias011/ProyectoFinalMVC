@model ProyectoFinalMVC.Models.Tutorial
@{
    ViewData["Title"] = Model.Titulo;
}

<h1>@Model.Titulo</h1>
<hr />

@if (TempData["MensajeExito"] != null)
{
    <div class="alert alert-success">@TempData["MensajeExito"]</div>
}

<p>
    <span class="badge bg-secondary">@Model.Tecnologia?.Nombre</span>
    <span class="badge bg-info text-dark">@ViewBag.TotalLikes Me gusta</span>
    <span class="badge bg-light text-dark border">Publicado @Model.FechaPublicacion.ToLocalTime().ToString("dd/MM/yyyy")</span>
    <span class="badge bg-light text-dark border">Por @Model.Usuario?.NombreUsuario</span>
</p>

<div class="mb-3">
    <p>@Model.Descripcion</p>
    <a href="@Model.Url" target="_blank" class="btn btn-primary">Ver tutorial</a>

    @if (!string.IsNullOrEmpty(Model.UrlImagen))
    {
        <div class="mt-3">
            <img src="@Model.UrlImagen" alt="@Model.Titulo" class="img-fluid rounded" />
        </div>
    }
</div>

@* ACCIONES: LIKE, GUARDAR Y EDITAR/ELIMINAR *@
<div class="border rounded p-3 mb-4">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <div class="d-flex flex-wrap gap-2 align-items-center">
            @if (ViewBag.LeGusta)
            {
                <form asp-controller="Like" asp-action="Eliminar" method="post">
                    <input type="hidden" name="tutorialId" value="@Model.Idtutorial" />
                    <button type="submit" class="btn btn-outline-danger">Quitar Me gusta</button>
                </form>
            }
            else
            {
                <form asp-controller="Like" asp-action="Crear" method="post">
                    <input type="hidden" name="tutorialId" value="@Model.Idtutorial" />
                    <button type="submit" class="btn btn-outline-primary">Me gusta</button>
                </form>
            }

            @if (ViewBag.ListasPropias != null && ((IEnumerable<ProyectoFinalMVC.Models.ListaPersonal>)ViewBag.ListasPropias).Any())
            {
                <form asp-controller="TutorialGuardado" asp-action="Crear" method="post" class="d-flex gap-2">
                    <input type="hidden" name="tutorialId" value="@Model.Idtutorial" />
                    <select name="idListaPersonal" class="form-select form-select-sm" style="width: auto;">
                        @foreach (var lista in (IEnumerable<ProyectoFinalMVC.Models.ListaPersonal>)ViewBag.ListasPropias)
                        {
                            <option value="@lista.IdListaPersonal">@lista.Nombre</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-sm btn-outline-success">Guardar en la lista</button>
                </form>
                <a asp-controller="ListaPersonal" asp-action="Crear" class="btn btn-sm btn-outline-secondary">Crear otra lista</a>
            }
            else
            {
                <a asp-controller="ListaPersonal" asp-action="Crear" class="btn btn-sm btn-outline-success">Crear una lista para guardarlo</a>
            }

            @if (User.Identity?.Name == Model.Usuario?.NombreUsuario || User.IsInRole("Administrador"))
            {
                <a asp-controller="Tutorial" asp-action="Editar" asp-route-id="@Model.Idtutorial" class="btn btn-sm btn-outline-secondary">Editar</a>
                <a asp-controller="Tutorial" asp-action="Eliminar" asp-route-id="@Model.Idtutorial" class="btn btn-sm btn-outline-danger">Eliminar</a>
            }
        </div>
    }
    else
    {
        <p class="mb-0">
            <a asp-controller="Auth" asp-action="Login">Inicia sesión</a> para dar Me gusta o guardar este tutorial.
        </p>
    }
</div>

@* COMENTARIOS *@
<h3>Comentarios</h3>
<a asp-controller="Comentario" asp-action="Index" asp-route-idTutorial="@Model.Idtutorial" class="btn btn-outline-primary btn-sm">
    Ver y agregar comentarios (@Model.Comentarios.Count)
</a>